## vendor prop for r9s

## Fingerprint
ro.vendor.fingerprint.sensor_location=540|2055|110
ro.vendor.fingerprint.type=udfps_optical
ro.vendor.fingerprint.request_touch_event=true
ro.vendor.fingerprint.screen_off_press_delay=100

## WiFi
ro.vendor.wifi.sap.interface=wlan1
vendor.wifi.dualconcurrent.interface=wlan0
wifi.concurrent.interface=wlan0
